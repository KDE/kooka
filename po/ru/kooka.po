#: kookascanparams.cpp:122
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<title>Gallery Mode - No scanner selected</title><nl/><nl/>In this mode you "
"can browse, manipulate and OCR images already in the gallery.<nl/><nl/><link "
"url=\"a:1\">Select a scanner device</link> to perform scanning, or <link url="
"\"a:2\">add a device</link> if a scanner is not automatically detected."
msgstr ""
"<title>Режим галереи — сканер не выбран</title><nl/><nl/>В этом режиме можно "
"просматривать изображения из галереи, изменять их и распознавать в них текст."
"<nl/><nl/>Чтобы сканировать, <link url=\"a:1\">выберите устройство "
"сканирования</link>, а если сканер не определяется автоматически — <link url="
"\"a:2\">добавьте устройство</link>."

